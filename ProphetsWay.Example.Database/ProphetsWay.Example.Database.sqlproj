<Project Sdk="Microsoft.Build.Sql/2.2.0">

	<PropertyGroup>
		<Name>ProphetsWay.Example.Database</Name>
		<ProjectGuid>{828e118d-68ba-4f92-8794-46cbf85ac4c3}</ProjectGuid>
		<DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
		<RootNamespace>ProphetsWay.Example.Database</RootNamespace>
		<AssemblyName>ProphetsWay.Example.Database</AssemblyName>
		<ModelCollation>1033,CI</ModelCollation>
		<DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
		<DefaultFilegroup>PRIMARY</DefaultFilegroup>
		<DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
		<DeployToDatabase>True</DeployToDatabase>
		<IncludeCompositeObjects>True</IncludeCompositeObjects>
		<TargetDatabaseSet>True</TargetDatabaseSet>
		<SqlServerVerification>False</SqlServerVerification>
	</PropertyGroup>

	<ItemGroup>
		<!-- PostBuildScripts are pulled in by the post-deployment script, not compiled into the model. -->
		<Build Remove="PostBuildScripts\**\*.sql" />
		<PostDeploy Include="PostBuildScripts\PostDeploymentStart.sql" />
		<None Include="PostBuildScripts\CreateDbUser.sql" />
		<None Include="PostBuildScripts\PurgeSeedData.sql" />
		<None Include="PostBuildScripts\CreateCompanies.sql" />
		<None Include="PostBuildScripts\CreateJobs.sql" />
		<None Include="PostBuildScripts\CreateUsers.sql" />
		<None Include="PostBuildScripts\CreateTransactions.sql" />
		<None Include="ProphetsWay.Example.localhost.publish.xml" />
	</ItemGroup>

	<ItemGroup>
		<SqlCmdVariable Include="DatabaseInstance">
			<DefaultValue>ProphetsWay.Example</DefaultValue>
			<Value>$(SqlCmdVar__1)</Value>
		</SqlCmdVariable>
	</ItemGroup>

</Project>